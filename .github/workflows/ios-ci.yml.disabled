name: iOS CI/CD Pipeline

# Created by Jason Lu on 20:55:00 10/11/2025
# iOS App Continuous Integration and Deployment

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:
    inputs:
      build_type:
        description: 'Build type'
        required: true
        default: 'simulator'
        type: choice
        options:
        - simulator
        - device
        - test
        - full

env:
  DEVELOPMENT_TEAM: 6P6P5HUVGU
  BUNDLE_IDENTIFIER: com.jason.fit
  CONFIGURATION: Debug

jobs:
  # Build and Test
  build-and-test:
    runs-on: macos-latest

    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: latest-stable

    - name: Cache DerivedData
      uses: actions/cache@v3
      with:
        path: DerivedData
        key: ${{ runner.os }}-deriveddata-${{ hashFiles('**/*.swift') }}
        restore-keys: |
          ${{ runner.os }}-deriveddata-

    - name: Install Dependencies
      run: |
        if [ -f Package.swift ]; then
          swift package resolve
        fi
        if [ -f Podfile ]; then
          pod install
        fi

    - name: Build for iOS Simulator
      run: |
        ./scripts/build-devops.sh simulator $CONFIGURATION

    - name: Run Unit Tests
      run: |
        ./scripts/build-devops.sh test $CONFIGURATION

    - name: Upload Build Artifacts
      uses: actions/upload-artifact@v3
      if: always()
      with:
        name: build-artifacts-${{ github.sha }}
        path: |
          build-artifacts/
          logs/
        retention-days: 30

    - name: Upload Test Results
      uses: actions/upload-artifact@v3
      if: always()
      with:
        name: test-results-${{ github.sha }}
        path: test-results/
        retention-days: 30

  # Code Quality Checks
  code-quality:
    runs-on: macos-latest

    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: latest-stable

    - name: SwiftLint
      run: |
        if command -v swiftlint &> /dev/null; then
          swiftlint
        else
          echo "SwiftLint not installed, skipping"
        fi

    - name: SwiftFormat
      run: |
        if command -v swiftformat &> /dev/null; then
          swiftformat --lint .
        else
          echo "SwiftFormat not installed, skipping"
        fi

  # Security Scan
  security-scan:
    runs-on: macos-latest

    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Run Security Analysis
      run: |
        # Basic security checks
        echo "Running security analysis..."

        # Check for hardcoded secrets
        if grep -r "password\|secret\|key\|token" --include="*.swift" . | grep -v "//.*password\|//.*secret"; then
          echo "⚠️ Potential hardcoded secrets found"
          exit 1
        fi

        # Check bundle identifier security
        BUNDLE_ID=$(grep "PRODUCT_BUNDLE_IDENTIFIER" Fit.xcodeproj/project.pbxproj | head -1 | cut -d'=' -f2 | tr -d ' ;')
        if [[ "$BUNDLE_ID" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z0-9.-]+$ ]]; then
          echo "✅ Bundle identifier format is valid"
        else
          echo "❌ Invalid bundle identifier format: $BUNDLE_ID"
          exit 1
        fi

  # Build for Distribution (only on main branch)
  build-distribution:
    runs-on: macos-latest
    needs: [build-and-test, code-quality, security-scan]
    if: github.ref == 'refs/heads/main'

    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: latest-stable

    - name: Build for iOS Device
      run: |
        ./scripts/build-devops.sh device Release

    - name: Create Archive
      run: |
        ./scripts/build-devops.sh archive Release

    - name: Upload Distribution Artifacts
      uses: actions/upload-artifact@v3
      with:
        name: distribution-artifacts-${{ github.sha }}
        path: |
          build-artifacts/archive/
          build-artifacts/ipa/
          build-artifacts/deployment/
        retention-days: 90

  # Deploy to TestFlight (manual trigger)
  deploy-testflight:
    runs-on: macos-latest
    needs: [build-distribution]
    if: github.event_name == 'workflow_dispatch' && github.event.inputs.build_type == 'full'
    environment: production

    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: latest-stable

    - name: Download Distribution Artifacts
      uses: actions/download-artifact@v3
      with:
        name: distribution-artifacts-${{ github.sha }}
        path: build-artifacts/

    - name: Deploy to TestFlight
      env:
        APPLE_ID: ${{ secrets.APPLE_ID }}
        APPLE_APP_SPECIFIC_PASSWORD: ${{ secrets.APPLE_APP_SPECIFIC_PASSWORD }}
        APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
      run: |
        echo "Deploying to TestFlight..."
        # Add TestFlight deployment logic here
        # xcodebuild -exportArchive -archivePath build-artifacts/archive/Fit.xcarchive \
        #   -exportPath build-artifacts/ipa \
        #   -exportOptionsPlist build-artifacts/archive/ExportOptions.plist \
        #   -api_key

    - name: Notify Deployment
      if: always()
      run: |
        echo "🎉 Deployment completed!"
        # Add notification logic here (Slack, email, etc.)

  # Performance Monitoring
  performance-monitoring:
    runs-on: macos-latest
    needs: [build-and-test]
    if: always()

    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Download Build Artifacts
      uses: actions/download-artifact@v3
      with:
        name: build-artifacts-${{ github.sha }}
        path: build-artifacts/

    - name: Analyze Build Performance
      run: |
        echo "Analyzing build performance..."

        # Parse build report
        if [ -f build-artifacts/simulator-build-report.json ]; then
          echo "Build Report:"
          cat build-artifacts/simulator-build-report.json | jq '.'

          # Extract metrics
          COMPILED_FILES=$(cat build-artifacts/simulator-build-report.json | jq -r '.metrics.compiledFiles')
          WARNINGS=$(cat build-artifacts/simulator-build-report.json | jq -r '.metrics.warnings')
          ERRORS=$(cat build-artifacts/simulator-build-report.json | jq -r '.metrics.errors')

          echo "📊 Build Metrics:"
          echo "  Compiled Files: $COMPILED_FILES"
          echo "  Warnings: $WARNINGS"
          echo "  Errors: $ERRORS"

          # Create performance report
          cat > performance-report.md << EOF
        # Build Performance Report

        **Build Date:** $(date)
        **Commit:** ${{ github.sha }}
        **Branch:** ${{ github.ref_name }}

        ## Metrics
        - **Compiled Files:** $COMPILED_FILES
        - **Warnings:** $WARNINGS
        - **Errors:** $ERRORS

        ## Performance Analysis
        EOF

          # Add performance recommendations
          if [ "$WARNINGS" -gt 10 ]; then
            echo "- ⚠️ High number of warnings detected. Consider addressing warnings." >> performance-report.md
          fi

          if [ "$ERRORS" -gt 0 ]; then
            echo "- ❌ Build errors detected. Review build logs." >> performance-report.md
          fi

          echo "Performance report generated"
        fi

    - name: Upload Performance Report
      uses: actions/upload-artifact@v3
      with:
        name: performance-report-${{ github.sha }}
        path: performance-report.md
        retention-days: 30